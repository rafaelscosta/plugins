{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/project-continuity/pcp-resume-resolution-1/resume-resolution.schema.json",
  "title": "Project Continuity Resume Resolution v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "created_at",
    "reference",
    "transport",
    "local_project",
    "source",
    "pcp",
    "planning",
    "resume_brief",
    "execution_gate"
  ],
  "properties": {
    "format": {"const": "pcp-resume-resolution/1"},
    "created_at": {"type": "string", "format": "date-time"},
    "reference": {"type": ["string", "null"]},
    "transport": {"enum": ["file", "github"]},
    "local_project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "checkpoint_id",
        "checkpoint_digest",
        "checkpoint_status",
        "surface_status",
        "handoff_id"
      ],
      "properties": {
        "project_id": {"type": "string", "minLength": 1},
        "checkpoint_id": {"type": "string", "minLength": 1},
        "checkpoint_digest": {
          "type": ["string", "null"],
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "checkpoint_status": {"enum": ["draft", "sealed"]},
        "surface_status": {"type": ["string", "null"]},
        "handoff_id": {"type": ["string", "null"]}
      }
    },
    "pcp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compatibility",
        "compatibility_detail",
        "reconciliation_draft",
        "external_promoted",
        "historical_completion_claims"
      ],
      "properties": {
        "compatibility": {
          "enum": [
            "exact",
            "advanced",
            "drift",
            "diverged",
            "project-mismatch",
            "unverifiable",
            "invalid"
          ]
        },
        "compatibility_detail": {"type": ["object", "null"]},
        "reconciliation_draft": {"type": "string", "minLength": 1},
        "external_promoted": {"const": false},
        "historical_completion_claims": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "statement", "status"],
            "properties": {
              "id": {"type": ["string", "null"]},
              "statement": {"type": ["string", "null"]},
              "status": {"const": "requires-reverification"}
            }
          }
        }
      }
    },
    "planning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "prior", "result", "transitions", "frontier"],
      "properties": {
        "status": {"enum": ["absent", "reconciliation-required", "reconciled"]},
        "prior": {
          "anyOf": [
            {"type": "null"},
            {"$ref": "#/$defs/planning_ref"}
          ]
        },
        "result": {
          "anyOf": [
            {"type": "null"},
            {"$ref": "#/$defs/planning_ref"}
          ]
        },
        "transitions": {"type": "array", "items": {"type": "object"}},
        "frontier": {
          "anyOf": [
            {"type": "null"},
            {"$ref": "#/$defs/frontier"}
          ]
        }
      }
    },
    "resume_brief": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objective", "surviving_decisions", "blockers", "candidate_frontier"],
      "properties": {
        "objective": {
          "type": "object",
          "additionalProperties": false,
          "required": ["text", "confidence", "instruction"],
          "properties": {
            "text": {"type": ["string", "null"]},
            "confidence": {"const": "reported"},
            "instruction": {"type": "string", "minLength": 1}
          }
        },
        "surviving_decisions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "statement", "confidence"],
            "properties": {
              "id": {"type": ["string", "null"]},
              "statement": {"type": ["string", "null"]},
              "confidence": {"const": "reported"}
            }
          }
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title", "source"],
            "properties": {
              "id": {"type": ["string", "null"]},
              "title": {"type": ["string", "null"]},
              "source": {"enum": ["checkpoint", "planning"]}
            }
          }
        },
        "candidate_frontier": {
          "anyOf": [
            {"type": "null"},
            {"$ref": "#/$defs/frontier"}
          ]
        }
      }
    },
    "execution_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_reconciliation_required",
        "planning_reconciliation_required",
        "candidate_frontier_available",
        "external_head_promotion_allowed"
      ],
      "properties": {
        "repository_reconciliation_required": {"const": true},
        "planning_reconciliation_required": {"type": "boolean"},
        "candidate_frontier_available": {"type": "boolean"},
        "external_head_promotion_allowed": {"const": false}
      }
    }
  },
  "$defs": {
    "planning_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "digest"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "frontier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_id", "title", "kind", "status", "priority"],
      "properties": {
        "item_id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "kind": {"enum": ["release", "epic", "story", "task"]},
        "status": {"enum": ["accepted", "ready", "in_progress"]},
        "priority": {"enum": ["critical", "high", "medium", "low"]}
      }
    }
  }
}
