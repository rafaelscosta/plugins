{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/project-continuity/pcp-1/checkpoint.schema.json",
  "title": "Project Continuity Checkpoint PCP/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "checkpoint_id",
    "created_at",
    "producer",
    "project_id",
    "parent",
    "baseline",
    "objective",
    "claims",
    "evidence",
    "open_work",
    "next_action",
    "risks",
    "verification"
  ],
  "properties": {
    "protocol_version": {
      "const": "pcp/1"
    },
    "checkpoint_id": {
      "type": "string",
      "pattern": "^pcp-[A-Za-z0-9._-]{8,}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface",
        "model",
        "session_ref"
      ],
      "properties": {
        "surface": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "session_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "parent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checkpoint_id",
        "content_digest"
      ],
      "properties": {
        "checkpoint_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "content_digest": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          ]
        }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root_hint",
        "git",
        "files"
      ],
      "properties": {
        "root_hint": {
          "type": "string"
        },
        "git": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "commit",
                "branch",
                "dirty",
                "worktree_sha256",
                "project_snapshot_sha256"
              ],
              "properties": {
                "commit": {
                  "type": "string",
                  "pattern": "^[0-9a-fA-F]{7,64}$"
                },
                "branch": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "dirty": {
                  "type": "boolean"
                },
                "worktree_sha256": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "project_snapshot_sha256": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                }
              }
            }
          ]
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "size",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "size": {
                "type": "integer",
                "minimum": 0
              },
              "sha256": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current",
        "definition_of_done"
      ],
      "properties": {
        "current": {
          "type": "string",
          "minLength": 1
        },
        "definition_of_done": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "confidence",
          "statement",
          "evidence",
          "supersedes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "completed",
              "decision",
              "constraint",
              "finding",
              "assumption"
            ]
          },
          "confidence": {
            "enum": [
              "verified",
              "reported",
              "inferred"
            ]
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "supersedes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "label",
          "observed_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "file_hash",
              "git_commit",
              "command",
              "test",
              "artifact",
              "source",
              "user_confirmation"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "open_work": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "status",
          "priority",
          "acceptance_criteria",
          "depends_on"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "todo",
              "blocked"
            ]
          },
          "priority": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "acceptance_criteria": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        }
      }
    },
    "next_action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "work_item_id",
        "instruction",
        "acceptance_criteria"
      ],
      "properties": {
        "work_item_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "instruction": {
          "type": "string"
        },
        "acceptance_criteria": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "severity",
          "mitigation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "mitigation": {
            "type": "string"
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "sealed_at",
        "content_digest",
        "policy",
        "surface_status"
      ],
      "properties": {
        "status": {
          "enum": [
            "draft",
            "sealed"
          ]
        },
        "sealed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "content_digest": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          ]
        },
        "policy": {
          "const": "evidence-required-v1"
        },
        "surface_status": {
          "enum": [
            "unknown",
            "unverifiable",
            "historically-verified"
          ]
        }
      }
    }
  }
}
